# Change this to use a non-default directory for Vector data storage:
# data_dir: "/var/lib/vector"

# Random Syslog-formatted logs


sources:
  critical_journald:
    type: journald
    current_boot_only: false
    include_matches:
      PRIORITY: [ "0", "1", "2" ] # Emergency, Alert, Critical

  host_metrics:
    type: host_metrics
    collectors:
      - cpu
      - disk
      - filesystem
      - load
      - host
      - memory
    filesystem:
      devices:
        excludes: ["binfmt_misc"]
      filesystems:
        excludes: ["binfmt_misc", "nsfs", "tmpfs", "devtmpfs"]
      mountpoints:
        excludes: ["*/proc/sys/fs/binfmt_misc", "*/run/docker/netns/*", "*/var/lib/docker/*", "*/snap/*"]


# Parse Syslog logs
# See the Vector Remap Language reference for more info: https://vrl.dev
transforms:
  convert_journald:
    type: "remap"
    inputs: ["critical_journald"]
    source: >-
      .app = .SYSLOG_IDENTIFIER

      .realtime = to_int(.__REALTIME_TIMESTAMP) ?? 0

      .datetime = from_unix_timestamp(round(.realtime / 1000000)) ?? now()

      .facility = to_syslog_facility(to_int(.SYSLOG_FACILITY) ?? 0) ?? ""

      .severity = to_int(.PRIORITY) ?? 0

      .level = to_syslog_level(.severity) ?? ""


sinks:
  critical_journald_sink:
    type: "loki"
    inputs: ["convert_journald"]
    endpoint: "http://radar-swarm-01:3100"
    encoding:
      codec: "json"
    labels:
      host: "{% raw %}{{ host }}{% endraw %}"
      source: "journald"
      severity: "{% raw %}{{ level }}{% endraw %}"
      job: "critical-events"
    healthcheck:
      enabled: false

  otel_metrics:
    type: "opentelemetry"
    inputs: ["host_metrics"]
    protocol:
      type: "http"
      uri: "http://radar-swarm-01:4318/v1/metrics"
      encoding:
        codec: "otlp"
    compression: "gzip"
    healthcheck:
      enabled: true
    resource:
      host.name: "{{ ansible_hostname }}"
      service.name: "vector-host-metrics"
      service.namespace: "infrastructure"


